# ThingsBoard Web UI Development Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/api/ws

# MQTT Configuration (for direct device communication)
VITE_MQTT_HOST=localhost
VITE_MQTT_PORT=9001
VITE_MQTT_WS_PATH=/mqtt

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK=false
