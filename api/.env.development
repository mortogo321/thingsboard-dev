# ThingsBoard API - Development Environment

# Application
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thingsboard
DB_USERNAME=thingsboard
DB_PASSWORD=thingsboard

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# JWT
JWT_SECRET=dev-secret-key-change-in-production-min-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# API Versioning
API_ENABLED_VERSIONS=v1,v2
API_DEFAULT_VERSION=v1
API_DEPRECATED_VERSIONS=

# Logging
LOG_LEVEL=DEBUG
