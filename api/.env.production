# ThingsBoard API - Production Environment

# Application
APP_ENV=production

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=thingsboard
DB_USERNAME=thingsboard
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883

# JWT (REQUIRED: generate with `openssl rand -base64 32`)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# API Versioning
API_ENABLED_VERSIONS=v1,v2
API_DEFAULT_VERSION=v1
API_DEPRECATED_VERSIONS=

# Logging
LOG_LEVEL=INFO

# Optional: SMTP
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
