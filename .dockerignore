# Root .dockerignore (used when build context is root)

# Git
.git/
.gitignore

# IDE
.idea/
*.iml
.vscode/

# Documentation
*.md

# API directory (excluded for web builds)
api/

# Web build artifacts
web/node_modules/
web/dist/
web/build/
web/.angular/

# Test files
**/coverage/
**/*.spec.ts
**/e2e/

# Environment files (api/.env.production is copied explicitly in api builds,
# which use ./api as context with api/.dockerignore)
**/.env*

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
